+// Touch gesture recognition, independent of SDL/Android for deterministic tests.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <functional>
+#include <map>
+#include <optional>
+#include <iterator>
+#include <utility>
+
+namespace wz { namespace touch {
+struct Point { float x = 0, y = 0; };
+inline float distance(Point a, Point b) { return std::hypot(a.x - b.x, a.y - b.y); }
+enum class Kind { Tap, DoubleTap, Pan, BoxBegin, BoxMove, BoxEnd, BoxCancel, Deselect, Pinch, Rotate };
+struct Action {
+    Kind kind;
+    Point at{}, from{};
+    float scale = 1; // New camera distance / old camera distance.
+    float radians = 0; // Incremental clockwise rotation, in screen coordinates.
+};
+
+class Gestures {
+public:
+    using Time = uint64_t;
+    using FingerId = int64_t;
+    static constexpr Time HoldMs = 420, DoubleTapMs = 300, TapMs = 280;
+    static constexpr float Slop = 12, DoubleTapRadius = 28;
+    explicit Gestures(std::function<void(const Action &)> output) : emit(std::move(output)) {}
+    bool touching() const { return !fingers.empty(); }
+
+    void down(FingerId id, Point p, Time now) {
+        if (fingers.count(id)) return;
+        tick(now);
+        if (fingers.empty()) {
+            if (tap && (now > tap->time + DoubleTapMs || distance(p, tap->at) > DoubleTapRadius)) flushTap();
+            mode = Mode::Pending; start = now; origin = p;
+            fingers.emplace(id, Finger{p, p});
+            return;
+        }
+        tap.reset(); // Never issue an order when a second finger starts a gesture.
+        if (mode == Mode::Box) emit({Kind::BoxCancel});
+        bool mayDeselect = mode == Mode::Pending && now - start <= TapMs;
+        fingers.emplace(id, Finger{p, p});
+        if (fingers.size() != 2 || mode == Mode::Blocked) { mode = Mode::Blocked; return; }
+        mode = Mode::Two;
+        twoTap = mayDeselect; pinching = twisting = twoDirty = false;
+        twoMode = TwoMode::Pending;
+        initialDistance = lastDistance = pairDistance();
+        twoCenter = lastCenter = pairCenter();
+        pairStartA = fingers.begin()->second.at;
+        pairStartB = std::next(fingers.begin())->second.at;
+        lastAngle = pairAngle(); pendingAngle = 0;
+        angleValid = initialDistance >= MinTwistSpan;
+    }
+
+    void motion(FingerId id, Point p, Time now) {
+        auto it = fingers.find(id);
+        if (it == fingers.end()) return;
+        // Honor a completed hold even if rendering stalled between samples.
+        if (mode == Mode::Pending && now - start >= HoldMs && it->second.travel <= Slop) tick(now);
+        Point previous = it->second.at;
+        it->second.at = p;
+        it->second.travel = std::max(it->second.travel, distance(it->second.start, p));
+        if (mode == Mode::Pending) {
+            if (it->second.travel > Slop) {
+                mode = Mode::Pan; tap.reset();
+                emit({Kind::Pan, p, origin});
+            } else tick(now);
+        } else if (mode == Mode::Pan) {
+            emit({Kind::Pan, p, previous});
+        } else if (mode == Mode::Box) {
+            emit({Kind::BoxMove, p, origin});
+        } else if (mode == Mode::Two) {
+            if (it->second.travel > Slop) twoTap = false;
+            // SDL sends one motion event per finger. Read the pair once at the
+            // end of the frame so a parallel swipe is not mistaken for a pinch
+            // or twist while only the first finger's position has been updated.
+            twoDirty = fingers.size() == 2;
+        }
+    }
+
+    void up(FingerId id, Point p, Time now) {
+        if (!fingers.count(id)) return;
+        motion(id, p, now);
+        updateTwo(); // Commit the final positions before either finger is removed.
+        if (mode == Mode::Pending && now - start <= TapMs) {
+            if (tap && now - tap->time <= DoubleTapMs && distance(p, tap->at) <= DoubleTapRadius) {
+                tap.reset(); emit({Kind::DoubleTap, p});
+            } else {
+                flushTap(); tap = Tap{p, now};
+            }
+        } else if (mode == Mode::Box) {
+            emit({distance(origin, p) > Slop ? Kind::BoxEnd : Kind::BoxCancel, p, origin});
+        } else if (mode == Mode::Pending) {
+            tap.reset();
+        }
+        fingers.erase(id);
+        if (fingers.empty()) {
+            if (mode == Mode::Two && twoTap && now - start <= TapMs) emit({Kind::Deselect, twoCenter});
+            mode = Mode::None;
+        }
+    }
+
+    void tick(Time now) {
+        // A possible second tap must finish before committing the first tap.
+        if (tap && now > tap->time + DoubleTapMs && fingers.empty()) flushTap();
+        if (mode == Mode::Pending && fingers.size() == 1 && now - start >= HoldMs) {
+            tap.reset(); mode = Mode::Box;
+            emit({Kind::BoxBegin, origin, origin});
+        }
+        updateTwo();
+    }
+
+    void cancel() {
+        if (mode == Mode::Box) emit({Kind::BoxCancel});
+        fingers.clear(); tap.reset(); mode = Mode::None; twoDirty = false;
+    }
+private:
+    enum class Mode { None, Pending, Pan, Box, Two, Blocked };
+    enum class TwoMode { Pending, Swipe, Transform };
+    static constexpr float Pi = 3.14159265358979323846f;
+    static constexpr float TwistSlop = Pi / 30; // Six degrees, plus the movement slop below.
+    static constexpr float MinTwistSpan = 2 * Slop;
+    static constexpr float SwipeRadiansPerPixel = Pi / 720; // Desktop sensitivity: 0.25 degrees/pixel.
+    struct Finger { Point start, at; float travel = 0; };
+    struct Tap { Point at; Time time; };
+    std::function<void(const Action &)> emit;
+    std::map<FingerId, Finger> fingers;
+    std::optional<Tap> tap;
+    Mode mode = Mode::None;
+    TwoMode twoMode = TwoMode::Pending;
+    Time start = 0;
+    Point origin{}, twoCenter{}, lastCenter{}, pairStartA{}, pairStartB{};
+    bool twoTap = false, pinching = false, twisting = false, twoDirty = false, angleValid = false;
+    float initialDistance = 0, lastDistance = 0;
+    float lastAngle = 0, pendingAngle = 0;
+    float pairDistance() const { auto a = fingers.begin(), b = std::next(a); return distance(a->second.at, b->second.at); }
+    Point pairCenter() const { auto a = fingers.begin(), b = std::next(a); return {(a->second.at.x + b->second.at.x) / 2, (a->second.at.y + b->second.at.y) / 2}; }
+    float pairAngle() const { auto a = fingers.begin(), b = std::next(a); return std::atan2(b->second.at.y - a->second.at.y, b->second.at.x - a->second.at.x); }
+
+    void updateTwo() {
+        if (mode != Mode::Two || !twoDirty || fingers.size() != 2) return;
+        twoDirty = false;
+        const float current = pairDistance();
+        const Point center = pairCenter();
+        const float angle = pairAngle();
+        if (angleValid && current >= MinTwistSpan) {
+            const float delta = std::remainder(angle - lastAngle, 2 * Pi);
+            // Near-overlapping fingers can exchange sides between samples.
+            // Rebase an ambiguous half-turn rather than snapping the camera.
+            if (std::abs(delta) > Pi / 2) { pendingAngle = 0; twisting = false; }
+            else pendingAngle += delta;
+        } else { pendingAngle = 0; twisting = false; }
+        angleValid = current >= MinTwistSpan;
+        lastAngle = angle;
+
+        const bool wantsTwist = std::abs(pendingAngle) > TwistSlop &&
+            std::abs(pendingAngle) * current / 2 > Slop;
+        const bool wantsPinch = std::abs(current - initialDistance) > Slop;
+        if (twoMode == TwoMode::Pending) {
+            const float dxA = fingers.begin()->second.at.x - pairStartA.x;
+            const float dxB = std::next(fingers.begin())->second.at.x - pairStartB.x;
+            const float smaller = std::min(std::abs(dxA), std::abs(dxB));
+            const float larger = std::max(std::abs(dxA), std::abs(dxB));
+            // Both fingers must travel horizontally together. An anchored or
+            // expanding pinch must not rotate just because its midpoint moves.
+            const bool swipe = dxA * dxB > 0 && smaller > Slop && smaller * 2 >= larger &&
+                std::abs(center.x - twoCenter.x) > std::abs(center.y - twoCenter.y) && !wantsTwist;
+            if (swipe) twoMode = TwoMode::Swipe;
+            else if (wantsPinch || wantsTwist) twoMode = TwoMode::Transform;
+            if (twoMode != TwoMode::Pending) twoTap = false;
+        }
+
+        if (twoMode == TwoMode::Swipe) {
+            const float rotation = (center.x - lastCenter.x) * SwipeRadiansPerPixel;
+            if (rotation != 0) emit({Kind::Rotate, center, {}, 1, rotation});
+            lastCenter = center;
+        } else if (twoMode == TwoMode::Transform) {
+            if (wantsPinch) pinching = true;
+            if (pinching) {
+                if (current > 1 && lastDistance > 1 && current != lastDistance)
+                    emit({Kind::Pinch, center, {}, lastDistance / current});
+                lastDistance = current;
+            }
+            if (wantsTwist) twisting = true;
+            if (twisting && pendingAngle != 0) {
+                emit({Kind::Rotate, center, {}, 1, pendingAngle});
+                pendingAngle = 0;
+            }
+        }
+    }
+    void flushTap() { if (tap) { Point p = tap->at; tap.reset(); emit({Kind::Tap, p}); } }
+};
+}} // namespace wz::touch
