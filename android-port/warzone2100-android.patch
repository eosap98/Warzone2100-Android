new file mode 100644
index 0000000000000000000000000000000000000000..ef1566291ea6fd53f4753ed8e553c27cd19f3a61
--- /dev/null
+++ b/lib/framework/android_locale.h
@@ -0,0 +1,29 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <clocale>
+#include <cstdlib>
+#include <libintl.h>
+
+namespace wz_android
+{
+// Bionic only provides C / C.UTF-8 locales. Let gettext choose the catalog via
+// LANGUAGE instead of asking setlocale() for unavailable locales such as id_ID.
+inline bool setCatalogLanguage(const char *language, const char *domain)
+{
+	if (!language || !*language || !setlocale(LC_ALL, "C.UTF-8"))
+	{
+		return false;
+	}
+	// On Android GNU gettext reads the locale environment, rather than trusting
+	// Bionic's limited setlocale() result. A plain C default ignores LANGUAGE.
+	if (setenv("LC_ALL", "C.UTF-8", 1) != 0 || setenv("LANGUAGE", language, 1) != 0)
+	{
+		return false;
+	}
+	setlocale(LC_NUMERIC, "C"); // Keep config files and simulation numbers portable.
+	// This invalidates gettext's cache after LANGUAGE changes, even when the
+	// text domain and libc locale stay the same.
+	return textdomain(domain) != nullptr;
+}
+}
