 }
+
+#if defined(__ANDROID__)
+// World gestures use game actions directly. In particular, selecting one unit
+// must not go through the desktop double-click handler (select all of a type).
+bool androidWorldInputAvailable()
+{
+    return GetGameMode() == GS_NORMAL && mapWidth > 1 && mapHeight > 1 &&
+        !gamePaused() && !gameUpdatePaused() && !InGameOpUp && !isInGamePopupUp &&
+        !bLoadSaveUp && !bDisplayMultiJoiningStatus && !loop_GetVideoStatus();
+}
+
+static bool androidTouchesWidget(const std::shared_ptr<WIDGET> &widget, wz::touch::Point point)
+{
+    if (!widget || !widget->visible() || !widget->screenGeometry().contains(static_cast<int>(point.x), static_cast<int>(point.y))) return false;
+    for (const auto &child : widget->children()) {
+        if (androidTouchesWidget(child, point)) return true;
+    }
+    if (widget->transparentToMouse() || widget->transparentToClicks()) return false;
+    // Invisible layout containers may fill the entire playfield.
+    return widget->type != WIDG_FORM || !(widget->style & WFORM_INVISIBLE);
+}
+
+bool androidWorldInputAt(wz::touch::Point point)
+{
+    if (!androidWorldInputAvailable() || tryingToGetLocation() || deliveryReposValid()) return false;
+    bool overWidget = false;
+    auto checkScreen = [&](const std::shared_ptr<W_SCREEN> &screen) {
+        if (!screen || !screen->psForm) return;
+        for (const auto &child : screen->psForm->children()) {
+            if (androidTouchesWidget(child, point)) { overWidget = true; break; }
+        }
+    };
+    if (getWidgetsStatus()) checkScreen(psWScreen);
+    widgForEachOverlayScreen([&](const std::shared_ptr<W_SCREEN> &screen, uint16_t) {
+        checkScreen(screen); return !overWidget;
+    });
+    return !overWidget;
+}
+
+void androidApplyWorldGesture(const wz::touch::Action &action)
+{
+    using wz::touch::Kind;
+    if (action.kind == Kind::BoxCancel) { dragBox3D.status = DRAG_INACTIVE; return; }
+    if (!androidWorldInputAvailable()) return;
+    switch (action.kind) {
+    case Kind::Tap:
+    case Kind::DoubleTap: {
+        if (!androidWorldInputAt(action.at)) return;
+        // The pointer just moved; update the world hit location before issuing
+        // an order rather than using the previous frame's terrain coordinates.
+        mouseTileX = mouseTileY = -1;
+        screenCoordToWorld(Vector2i(mouseX(), mouseY()), mousePos, mouseTileX, mouseTileY);
+        if (!tileOnMap(mouseTileX, mouseTileY)) return;
+        BASE_OBJECT *target = mouseTarget();
+        if (action.kind == Kind::DoubleTap) {
+            if (target && target->type == OBJ_DROID && target->player == selectedPlayer) {
+                auto *droid = static_cast<DROID *>(target);
+                if (isSelectable(droid)) {
+                    clearSelection(); SelectDroid(droid); intObjectSelected(droid); FeedbackOrderGiven();
+                }
+            }
+        } else {
+            // Gestures keep their meaning even when a desktop mouse preference
+            // is changed. Restore that preference after dispatching the action.
+            const bool savedRightClickOrders = bRightClickOrders;
+            bRightClickOrders = true;
+            if (selNumSelected(selectedPlayer) > 0 || bLasSatStruct) dealWithLMB();
+            else if (target && target->type == OBJ_STRUCTURE) dealWithRMB();
+            bRightClickOrders = savedRightClickOrders;
+        }
+        break;
+    }
+    case Kind::Deselect:
+        dragBox3D.status = DRAG_INACTIVE;
+        handleDeselectionClick();
+        break;
+    case Kind::Pan: {
+        if (getWarCamStatus()) camToggleStatus();
+        resetScroll();
+        const float speed = std::max(1.f, getViewDistance() / 500.f);
+        const float dx = -(action.at.x - action.from.x) * speed;
+        const float dz = (action.at.y - action.from.y) * speed;
+        const double angle = -playerPos.r.y * (M_PI / 32768);
+        playerPos.p.x += static_cast<int>(std::cos(angle) * dx + std::sin(angle) * dz);
+        playerPos.p.z += static_cast<int>(std::sin(angle) * dx - std::cos(angle) * dz);
+        CheckScrollLimits();
+        break;
+    }
+    case Kind::Pinch: {
+        const float target = glm::clamp(getViewDistance() * action.scale, 250.f,
+            static_cast<float>(NETisReplay() ? MAXDISTANCE_REPLAY : MAXDISTANCE));
+        animateToViewDistance(target, 0);
+        updateViewDistanceAnimation();
+        break;
+    }
+    case Kind::Rotate: {
+        if (getWarCamStatus()) camToggleStatus();
+        resetScroll();
+        // Rightward swipes / clockwise twists follow desktop rotation. Keep
+        // yaw in one revolution so repeated turns cannot overflow the angle.
+        const int delta = static_cast<int>(std::lround(action.radians * (32768.0 / M_PI)));
+        playerPos.r.y = (playerPos.r.y - delta) % DEG(360);
+        if (playerPos.r.y < 0) playerPos.r.y += DEG(360);
+        Vector3i rotation(playerPos.r.x, playerPos.r.y, playerPos.r.z);
+        camInformOfRotation(&rotation);
+        break;
+    }
+    case Kind::BoxBegin:
+    case Kind::BoxMove:
+    case Kind::BoxEnd:
+        dragBox3D.x1 = static_cast<int>(action.from.x);
+        dragBox3D.y1 = static_cast<int>(action.from.y);
+        dragBox3D.x2 = static_cast<int>(action.at.x);
+        dragBox3D.y2 = static_cast<int>(action.at.y);
+        if (action.kind == Kind::BoxEnd) {
+            clearSelection();
+            dragBox3D.status = DRAG_RELEASED;
+        } else dragBox3D.status = DRAG_DRAGGING;
+        break;
+    case Kind::BoxCancel:
+        break;
+    }
+}
+#endif
