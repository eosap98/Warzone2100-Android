diff --git a/lib/sdl/android_input.cpp b/lib/sdl/android_input.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..604cd6bf2cbb0aa699db90147459360bd546b84f
--- /dev/null
+++ b/lib/sdl/android_input.cpp
@@ -0,0 +1,118 @@
+// Android touch adapter. SPDX-License-Identifier: GPL-2.0-or-later
+#if defined(__ANDROID__)
+#include "android_input.h"
+#include "touch_gestures.h"
+#include "src/android_touch.h"
+#include <SDL3/SDL.h>
+#include <jni.h>
+#include <AL/alc.h>
+#include <set>
+
+extern float current_displayScaleFactor;
+namespace {
+using namespace wz::touch;
+bool usingTouch = true, uiGesture = false, uiPressed = false;
+SDL_FingerID uiFinger = 0;
+SDL_WindowID touchWindow = 0;
+std::set<SDL_FingerID> contacts;
+Point uiPosition{};
+Gestures gestures([](const Action &action) {
+    if (action.kind != Kind::BoxCancel) {
+        wzAndroidSetPointer(action.at.x * current_displayScaleFactor, action.at.y * current_displayScaleFactor);
+    }
+    androidApplyWorldGesture(action);
+});
+
+void uiButton(bool down, Point p) {
+    SDL_Event ev{};
+    ev.type = down ? SDL_EVENT_MOUSE_BUTTON_DOWN : SDL_EVENT_MOUSE_BUTTON_UP;
+    ev.button.windowID = touchWindow;
+    ev.button.which = SDL_TOUCH_MOUSEID;
+    ev.button.button = SDL_BUTTON_LEFT;
+    ev.button.down = down;
+    ev.button.clicks = 1;
+    ev.button.x = p.x; ev.button.y = p.y;
+    SDL_PushEvent(&ev);
+    uiPressed = down;
+}
+void uiMotion(Point p) {
+    SDL_Event ev{};
+    ev.type = SDL_EVENT_MOUSE_MOTION;
+    ev.motion.windowID = touchWindow;
+    ev.motion.which = SDL_TOUCH_MOUSEID;
+    ev.motion.state = uiPressed ? SDL_BUTTON_LMASK : 0;
+    ev.motion.x = p.x; ev.motion.y = p.y;
+    ev.motion.xrel = p.x - uiPosition.x; ev.motion.yrel = p.y - uiPosition.y;
+    SDL_PushEvent(&ev); uiPosition = p;
+}
+void cancelTouches() {
+    gestures.cancel();
+    if (uiPressed) uiButton(false, {-100, -100}); // Release outside controls, never activate a button on cancellation.
+    contacts.clear(); uiGesture = false;
+}
+}
+
+extern "C" JNIEXPORT void JNICALL
+Java_org_warzone2100_android_GameActivity_nativePauseAudio(JNIEnv *, jclass, jboolean paused)
+{
+    ALCcontext *context = alcGetCurrentContext();
+    if (!context) return;
+    ALCdevice *device = alcGetContextsDevice(context);
+    if (!device || !alcIsExtensionPresent(device, "ALC_SOFT_pause_device")) return;
+    using DeviceFunction = void (*)(ALCdevice *);
+    auto function = reinterpret_cast<DeviceFunction>(alcGetProcAddress(
+        device, paused ? "alcDevicePauseSOFT" : "alcDeviceResumeSOFT"));
+    if (function) function(device);
+}
+
+bool wzAndroidUsingTouch() { return usingTouch; }
+
+void wzAndroidHandleEvent(const SDL_Event &event)
+{
+    if ((event.type == SDL_EVENT_MOUSE_MOTION && event.motion.which != SDL_TOUCH_MOUSEID) ||
+        ((event.type == SDL_EVENT_MOUSE_BUTTON_DOWN || event.type == SDL_EVENT_MOUSE_BUTTON_UP) && event.button.which != SDL_TOUCH_MOUSEID)) {
+        usingTouch = false;
+        gestures.cancel();
+    }
+    if (event.type == SDL_EVENT_WILL_ENTER_BACKGROUND || event.type == SDL_EVENT_WINDOW_FOCUS_LOST ||
+        event.type == SDL_EVENT_WINDOW_PIXEL_SIZE_CHANGED || event.type == SDL_EVENT_FINGER_CANCELED) {
+        cancelTouches(); return;
+    }
+    if (event.type != SDL_EVENT_FINGER_DOWN && event.type != SDL_EVENT_FINGER_MOTION && event.type != SDL_EVENT_FINGER_UP) return;
+    usingTouch = true;
+    const auto &finger = event.tfinger;
+    SDL_Window *window = SDL_GetWindowFromID(finger.windowID);
+    if (!window) return;
+    int width = 0, height = 0; SDL_GetWindowSize(window, &width, &height);
+    Point pixel{finger.x * width, finger.y * height};
+    Point logical{pixel.x / current_displayScaleFactor, pixel.y / current_displayScaleFactor};
+    uint64_t time = finger.timestamp / 1000000;
+    if (event.type == SDL_EVENT_FINGER_DOWN) {
+        if (contacts.empty()) {
+            touchWindow = finger.windowID;
+            uiGesture = !androidWorldInputAt(logical);
+            if (uiGesture) {
+                gestures.cancel(); uiFinger = finger.fingerID;
+                uiMotion(pixel); uiButton(true, pixel);
+            }
+        }
+        contacts.insert(finger.fingerID);
+        if (!uiGesture) gestures.down(finger.fingerID, logical, time);
+    } else if (contacts.count(finger.fingerID)) {
+        if (uiGesture && finger.fingerID == uiFinger && uiPressed) {
+            uiMotion(pixel);
+            if (event.type == SDL_EVENT_FINGER_UP) uiButton(false, pixel);
+        } else if (!uiGesture) {
+            if (event.type == SDL_EVENT_FINGER_MOTION) gestures.motion(finger.fingerID, logical, time);
+            else gestures.up(finger.fingerID, logical, time);
+        }
+        if (event.type == SDL_EVENT_FINGER_UP) contacts.erase(finger.fingerID);
+    }
+}
+
+void wzAndroidUpdateGestures()
+{
+    if (!androidWorldInputAvailable()) gestures.cancel();
+    else gestures.tick(SDL_GetTicks());
+}
+#endif
